# Planning & Discovery Service — copy to .env.development or .env

# Service identity
SERVICE_NAME=planning-discovery-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8001
RELOAD=true
LOG_LEVEL=DEBUG

# ── Required ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://test:test123@localhost:5432/orcha-db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Provider: "openrouter" | "ollama"

LLM_COMPLETION_PROVIDER=openrouter
LLM_EMBEDDING_PROVIDER=ollama

# OpenRouter API key (required when LLM_COMPLETION_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-...

# Ollama base URL (required when LLM_EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Model identifiers
LLM_DECOMPOSITION_MODEL=google/gemini-2.0-flash-001
LLM_FALLBACK_MODEL=google/gemini-2.0-flash-001
LLM_VALIDATION_MODEL=google/gemini-2.0-flash-001
LLM_EMBEDDING_MODEL=nomic-embed-text
# Optional output dimensions for embedding models that support it
# (e.g. google/gemini-embedding-001, openai/text-embedding-3-small via OpenRouter).
# Keep unset to use provider defaults.
LLM_EMBEDDING_DIMENSION=768

# Confidence threshold
LLM_CONFIDENCE_THRESHOLD=0.75

# ── Database Pool ─────────────────────────────────────────────────────────────
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=20

# ── Kafka Consumer Groups ─────────────────────────────────────────────────────
KAFKA_MANIFEST_GROUP_ID=planning-manifest-processors
KAFKA_QUERY_GROUP_ID=planning-query-handlers

# ── Search ────────────────────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.75
TOP_K_CANDIDATES=5
