# Registry Service Configuration

# Service
SERVICE_NAME=registry-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# gRPC
GRPC_HOST=[::]
GRPC_PORT=50051

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/orcha?schema=public

# Security
PAT_TOKEN_PREFIX=orcha_pat_
PAT_TOKEN_LENGTH=40

# Adapter Settings
ADAPTER_TIMEOUT=10
ADAPTER_MAX_RETRIES=3
ADAPTER_BASE_DELAY=1.0

# Health Check
HEALTH_CHECK_INTERVAL=300  # 5 minutes
MAX_HEALTH_FAILURES=3

# Payment
PAYMENT_FACILITATOR_URL=https://api.orcha.bot/verify

# MCP Protocol
MCP_PROTOCOL_VERSION=2025-11-25

# Logging
LOG_LEVEL=INFO
