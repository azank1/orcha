# OpenRouter (required for ADK LiteLLM agents)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/anthropic/claude-sonnet-4-20250514

# Agent HTTP server
PORT=3011

# workspace-mcp (streamable HTTP)
WORKSPACE_MCP_PORT=8000
# WORKSPACE_MCP_URL=http://127.0.0.1:8000/mcp
# core | extended | complete — complete loads all tools per workspace-mcp README
WORKSPACE_MCP_TOOL_TIER=complete
MCP_SPAWN_ENABLED=1

# Google OAuth — token exchange on this agent must use the same redirect_uri as the consent step (gateway)
GOOGLE_OAUTH_CLIENT_ID=154461586131-v3n1dt2ffiia1itobhvh4u1pp0mgf04n.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5500/auth/callback

# Passed to workspace-mcp child (see upstream README)
# GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are shared with MCP when spawned
#
# External OAuth provider mode — injected automatically by server.py when spawning workspace-mcp.
# Setting these here has no effect; they are set programmatically so that the child process
# validates Google access tokens (ya29.*) from Authorization headers via Google's userinfo API
# instead of running its own OAuth flow or reading disk credentials.
#
# MCP_ENABLE_OAUTH21=true          (auto-set)
# EXTERNAL_OAUTH21_PROVIDER=true   (auto-set)
# WORKSPACE_MCP_STATELESS_MODE=true (auto-set — no disk writes for tokens)
