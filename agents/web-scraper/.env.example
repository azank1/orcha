# Web Scraper Agent — copy to .env

# Server
PORT=3004
HOST=0.0.0.0

# LLM (optional — enables summarize skill)
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-3.5-sonnet

# Google OAuth (optional — enables authenticated scraping)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# AUTH_REDIRECT_BASE=http://localhost:3004

# Token encryption key (optional — tokens stored in memory if unset)
# TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
