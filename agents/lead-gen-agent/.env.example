# ── LLM Provider ──────────────────────────────────────────────
# Switch between providers with one line — no code changes needed
# Options: anthropic | openai | grok | openrouter
LLM_PROVIDER=openrouter

# ── LLM API Keys — set the one matching your LLM_PROVIDER ─────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GROK_API_KEY=xai-...
OPENROUTER_API_KEY=sk-or-v1-...
# Default on OpenRouter: Z.ai GLM; override any OpenRouter slug if needed:
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ── Lead data APIs ─────────────────────────────────────────────
APOLLO_API_KEY=...
# Optional: Apollo People API Search base (default https://api.apollo.io/api/v1). Key goes in headers only — never URL params.
# APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
# auto (default)=try api_search then legacy | new=api_search only | legacy=/v1/mixed_people/search only
# APOLLO_SEARCH_MODE=auto
HUNTER_API_KEY=...
GOOGLE_MAPS_API_KEY=...

# ── CRM ───────────────────────────────────────────────────────
HUBSPOT_API_KEY=pat-na1-...

# ── A2A server auth ───────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# AGENT_API_KEY=your-secret-key

# ── Encryption (for storing user PATs securely) ───────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=...

# ── Gmail OAuth (multi-tenant email) ─────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:4567/oauth/gmail/callback

# ── Optional: email outreach ──────────────────────────────────
SENDGRID_API_KEY=
RESEND_API_KEY=...
GMAIL_APP_PASSWORD=...
FROM_EMAIL=you@example.com

# ── Agent location (for super-agent / metaorcha) ──────────────
LEAD_GEN_AGENT_URL=http://localhost:4567
