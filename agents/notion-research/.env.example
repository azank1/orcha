# Notion Research Agent — copy to .env

# Server
PORT=3006
HOST=0.0.0.0

# Notion API (required for all Notion operations)
NOTION_API_KEY=secret_...

# LLM — for analysis and structuring results
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Tavily — for web research skill
# TAVILY_API_KEY=tvly-...

# Google OAuth (optional — required for TradingView access only)
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3006/oauth/callback

# Encryption key (optional — for token storage)
# ENCRYPTION_KEY=<base64-encoded-key>
