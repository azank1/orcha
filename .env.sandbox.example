# Orcha Sandbox Environment
# Copy to .env.sandbox, fill in secrets, never commit the filled copy.
# -----------------------------------------------------------------------------

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password_here

# ── LLM Routing (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# Models used by Planning & Discovery
LLM_DECOMPOSITION_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_FALLBACK_MODEL=openai/gpt-4o
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_VALIDATION_MODEL=openai/gpt-4o-mini

# ── SuperAgent LLM ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# or OPENAI_API_KEY= if routing through OpenAI directly

# ── Spend Protection ──────────────────────────────────────────────────────────
# Max message requests forwarded per day across all sandbox sessions.
# 500 requests @ ~$0.10 avg each = ~$50/day. Adjust to your comfort level.
SANDBOX_MAX_DAILY_MESSAGES=500

# ── Agent API Keys ────────────────────────────────────────────────────────────
SERPER_API_KEY=          # search-agent (Google Serper) — leave blank for mock
NOTION_API_KEY=          # notion-research — leave blank to disable
# Google Workspace, lead-gen, ecommerce: set in their respective .env files if needed

# ── Gateway Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_32chars_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your sandbox public domain, or leave as * for local testing only
CORS_ORIGINS=*

# ── Payments (mock mode — no wallet needed) ────────────────────────────────────
PAYMENT_MODE=mock
