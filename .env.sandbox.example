# Orcha Sandbox Environment
# Copy to .env.sandbox, fill in secrets, never commit the filled copy.
# -----------------------------------------------------------------------------

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password_here

# ── LLM Routing (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# Models used by Planning & Discovery
LLM_DECOMPOSITION_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_FALLBACK_MODEL=openai/gpt-4o
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_VALIDATION_MODEL=openai/gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
LLM_EMBEDDING_PROVIDER=ollama

# ── SuperAgent LLM ────────────────────────────────────────────────────────────
ORCHESTRATOR_MODEL=anthropic/claude-haiku-4.5
SMALL_MODEL=anthropic/claude-haiku-4.5
ANTHROPIC_API_KEY=sk-ant-...
# or OPENAI_API_KEY= if routing through OpenAI directly

# ── Spend Protection ──────────────────────────────────────────────────────────
# Max message requests forwarded per day across all sandbox sessions.
# 500 requests @ ~$0.10 avg each = ~$50/day. Adjust to your comfort level.
SANDBOX_MAX_DAILY_MESSAGES=500
# One message per guest account on public sandbox (GET /auth/guest)
SANDBOX_GUEST_MAX_MESSAGES=1

# ── Agent API Keys ────────────────────────────────────────────────────────────
SERPER_API_KEY=          # search-agent (Google Serper) — leave blank for mock
NOTION_API_KEY=          # notion-research — leave blank to disable
# Google Workspace, lead-gen, ecommerce: set in their respective .env files if needed

# ── Gateway Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
VAULT_KEY=<generate-with-openssl-rand-base64-32>
REGISTRY_INTERNAL_KEY=dev-internal-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash, no wildcards).
# Default covers the sandbox served through nginx (http://localhost, port 80) and
# a local Vite dev server (http://localhost:3000). Without the portless entry a
# browser hitting the sandbox at http://localhost is CORS-blocked before it can
# reach /auth/register or /auth/login.
CORS_ORIGINS=http://localhost,http://localhost:3000
# For a public UI (Vercel + tunnel backend) — add your own domain(s):
# CORS_ORIGINS=http://localhost,https://app.orcha.ai,https://orcha.vercel.app

# ── Payments (mock mode — no wallet needed) ────────────────────────────────────
PAYMENT_MODE=mock
